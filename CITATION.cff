# CITATION.cff — machine-readable citation metadata.
# Adds a "Cite this repository" button; GitHub exports APA/BibTeX.
# HOW TO USE: fill authors, version, date. Keep only if the project is citable.
cff-version: 1.2.0
title: Project Name
message: "If you use this software, please cite it as below."
type: software
authors:
